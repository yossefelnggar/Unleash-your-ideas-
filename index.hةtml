    <span style="font-size:16px;">${icon}</span>
    <div style="flex:1;"><b style="font-size:13.5px;">${esc(label)}</b>${detail?`<div style="font-size:12px;color:${color};margin-top:2px;font-family:monospace;direction:ltr;text-align:right;white-space:pre-wrap;">${esc(detail)}</div>`:''}</div>
  </div>`;
}
function renderDiagnostics(app){
  if(!requireAuth())return;
  app.innerHTML=`
  <div class="card" style="padding:18px;max-width:640px;margin:0 auto;">
    <h2 style="font-weight:900;font-size:20px;margin-bottom:4px;">🩺 تشخيص المشاكل</h2>
    <div style="color:var(--muted);font-size:13px;margin-bottom:14px;">اضغط "ابدأ الفحص" وانتظر شوية، وبعدين انسخ النتيجة وابعتها لو فيه مشكلة.</div>
    <button class="btn btn-brand" id="diagRunBtn" onclick="runDiagnostics()">▶️ ابدأ الفحص</button>
    <button class="btn" id="diagCopyBtn" style="display:none;" onclick="copyDiagResult()">📋 انسخ النتيجة</button>
    <div id="diagResults" style="margin-top:16px;"></div>
  </div>`;
}
let __diagText='';
async function runDiagnostics(){
  const box=document.getElementById('diagResults');
  const btn=document.getElementById('diagRunBtn');
  btn.disabled=true;btn.textContent='جارٍ الفحص...';
  document.getElementById('diagCopyBtn').style.display='none';
  const lines=[];
  const add=(label,status,detail)=>{lines.push({label,status,detail});box.innerHTML=lines.map(l=>diagRow(l.label,l.status,l.detail)).join('');};
  add('تسجيل الدخول','ok',currentUser?('مسجّل دخول: '+currentUser.uid):'غير مسجل');
  try{const s=await db.ref('users/'+currentUser.uid).get();add('قراءة ملفك الشخصي (users)',s.exists()?'ok':'fail',s.exists()?'موجود':'الملف مش موجود');}catch(e){add('قراءة ملفك الشخصي (users)','fail',e.code||e.message);}
  try{await db.ref('startups').limitToLast(1).get();add('قراءة المشاريع (startups)','ok');}catch(e){add('قراءة المشاريع (startups)','fail',e.code||e.message);}
  try{
    const testId='diag_'+Date.now();
    const ref=db.ref('notifications/'+currentUser.uid+'/'+testId);
    await ref.set({type:'diag',text:'اختبار',fromId:currentUser.uid,read:true,createdAt:Date.now()});
    const back=await ref.get();
    await ref.remove();
    add('اختبار الكتابة والقراءة (write+read)',back.exists()?'ok':'fail',back.exists()?'الكتابة والقراءة شغالين':'الكتابة نجحت بس القراءة رجعت فاضية');
  }catch(e){add('اختبار الكتابة والقراءة (write+read)','fail',e.code||e.message);}
  try{
    const ucSnap=await db.ref('userConversations/'+currentUser.uid).get();
    const convIds=ucSnap.exists()?Object.keys(ucSnap.val()):[];
    add('قراءة قائمة محادثاتك','ok',convIds.length?('عدد المحادثات: '+convIds.length):'مفيش محادثات لسه');
    if(convIds.length){
      const cid=convIds[0];
      try{
        const testMid='diag_'+Date.now();
        const mref=db.ref('messages/'+cid+'/'+testMid);
        await mref.set({senderId:currentUser.uid,text:'رسالة اختبار تلقائية',createdAt:Date.now()});
        const back=await mref.get();
        await mref.remove();
        add('اختبار إرسال رسالة حقيقية',back.exists()?'ok':'fail',back.exists()?'الإرسال والقراءة شغالين 100%':'فشل');
      }catch(e){add('اختبار إرسال رسالة حقيقية','fail',e.code||e.message);}
    }
  }catch(e){add('قراءة قائمة محادثاتك','fail',e.code||e.message);}
  btn.disabled=false;btn.textContent='🔁 أعد الفحص';
  __diagText='نتيجة تشخيص VentureHub\n'+lines.map(l=>`${l.status==='ok'?'OK':'FAIL'} - ${l.label}${l.detail?(' | '+l.detail):''}`).join('\n');
  document.getElementById('diagCopyBtn').style.display='inline-block';
}
function copyDiagResult(){navigator.clipboard.writeText(__diagText).then(()=>toast('تم نسخ النتيجة','success')).catch(()=>toast('تعذر النسخ','error'));}

window.addEventListener('resize',()=>{});
</script>
</body>
</html>
