<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1">
<title>VentureHub — لاقي فريقك</title>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-auth-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-database-compat.js"></script>
<style>
:root{
  --bg:#f7f5f2; --ink:#14110f; --paper:#ffffff; --line:#14110f;
  --brand:#6c4dfb; --brand-ink:#ffffff; --accent:#00c48c; --warn:#ff8a3d; --danger:#ff4757;
  --muted:#726e68; --card:#ffffff; --soft:#efece6;
  --shadow: 4px 4px 0 var(--line);
  --shadow-sm: 2px 2px 0 var(--line);
}
*{box-sizing:border-box;}
body{font-family:'Cairo',sans-serif;background:var(--bg);color:var(--ink);margin:0;-webkit-tap-highlight-color:transparent;}
a{color:inherit;}
.hidden{display:none!important;}
.spin{animation:spin 1s linear infinite;}
@keyframes spin{to{transform:rotate(360deg);}}
.btn{border:2.5px solid var(--line);border-radius:14px;padding:10px 18px;font-weight:700;box-shadow:var(--shadow-sm);transition:transform .1s, box-shadow .1s;cursor:pointer;background:var(--paper);font-family:inherit;font-size:14px;}
.btn:active{transform:translate(2px,2px);box-shadow:0 0 0 var(--line);}
.btn:disabled{opacity:.55;cursor:not-allowed;}
.btn-brand{background:var(--brand);color:#fff;}
.btn-ghost{background:transparent;box-shadow:none;border-color:transparent;}
.btn-danger{background:var(--danger);color:#fff;}
.card{background:var(--card);border:2.5px solid var(--line);border-radius:18px;box-shadow:var(--shadow);}
.input{border:2.5px solid var(--line);border-radius:12px;padding:10px 14px;width:100%;background:#fff;font-family:inherit;font-size:15px;}
.input:focus{outline:none;box-shadow:3px 3px 0 var(--brand);}
textarea.input{resize:vertical;}
.badge{border:2px solid var(--line);border-radius:999px;padding:3px 10px;font-size:12px;font-weight:700;display:inline-block;}
.pill{border:2px solid var(--line);border-radius:999px;padding:4px 12px;font-size:13px;font-weight:600;background:#fff;cursor:pointer;display:inline-block;}
.pill.on{background:var(--ink);color:#fff;}
.avatar{border:2.5px solid var(--line);border-radius:50%;object-fit:cover;background:#eee;}
.toast-wrap{position:fixed;bottom:90px;left:0;right:0;display:flex;flex-direction:column;align-items:center;gap:8px;z-index:9999;pointer-events:none;}
.toast{background:var(--ink);color:#fff;border-radius:12px;padding:10px 16px;font-weight:600;font-size:14px;box-shadow:var(--shadow);animation:up .25s ease;}
.toast.error{background:var(--danger);}
.toast.success{background:var(--accent);}
@keyframes up{from{transform:translateY(10px);opacity:0;}to{transform:translateY(0);opacity:1;}}
.modal-backdrop{position:fixed;inset:0;background:rgba(20,17,15,.5);z-index:2000;display:flex;align-items:flex-end;justify-content:center;}
@media(min-width:768px){.modal-backdrop{align-items:center;}}
.modal-box{background:#fff;border:2.5px solid var(--line);border-radius:22px 22px 0 0;box-shadow:var(--shadow);width:100%;max-width:560px;max-height:92vh;overflow-y:auto;}
@media(min-width:768px){.modal-box{border-radius:22px;}}
.modal-close{position:sticky;top:0;background:#fff;display:flex;justify-content:flex-end;padding:10px 14px 0;z-index:1;}
.modal-close span{cursor:pointer;width:30px;height:30px;border-radius:50%;background:var(--soft);display:flex;align-items:center;justify-content:center;}
.loader-page{position:fixed;inset:0;background:var(--bg);z-index:99999;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;}
.skel{background:linear-gradient(90deg,var(--soft) 25%,#e2ded6 37%,var(--soft) 63%);background-size:400% 100%;animation:skel 1.4s ease infinite;border-radius:12px;}
@keyframes skel{0%{background-position:200% 0;}100%{background-position:-200% 0;}}
.tab-btn{border:2.5px solid var(--line);border-radius:999px;padding:8px 16px;font-weight:700;font-size:13px;white-space:nowrap;cursor:pointer;background:#fff;}
.tab-btn.active{background:var(--ink);color:#fff;}
.scrollx{overflow-x:auto;-ms-overflow-style:none;scrollbar-width:none;}
.scrollx::-webkit-scrollbar{display:none;}
.bottom-nav{position:fixed;bottom:0;left:0;right:0;background:#fff;border-top:2.5px solid var(--line);display:flex;justify-content:space-around;padding:8px 4px calc(env(safe-area-inset-bottom) + 6px);z-index:500;}
.bn-item{display:flex;flex-direction:column;align-items:center;gap:2px;font-size:11px;font-weight:700;color:var(--muted);flex:1;padding:4px;cursor:pointer;}
.bn-item.active{color:var(--brand);}
.core-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:14px;}
.msg-row{display:flex;gap:8px;align-items:flex-end;}
.msg-row.mine{flex-direction:row-reverse;}
.msg-avatar{width:26px;height:26px;}
.msg-bubble{background:var(--soft);border:2px solid var(--line);border-radius:16px;padding:8px 14px;font-size:14px;line-height:1.6;max-width:100%;word-break:break-word;}
.mine .msg-bubble{background:var(--brand);color:#fff;border-color:var(--line);}
.msg-meta{font-size:10px;color:var(--muted);margin-top:2px;}
.md-hide{}
@media(min-width:768px){.md-hide{display:none !important;}}
.md-show{}
@media(max-width:767px){
  .md-show{display:none!important;}
  .msg-list-mobile-hide{display:none!important;}
}
::placeholder{color:#b5b0a7;}
</style>
</head>
<body>

<div class="loader-page" id="loaderPage">
  <div style="width:44px;height:44px;background:var(--brand);border:2.5px solid var(--line);border-radius:12px;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:900;font-size:20px;">V</div>
  <div style="font-weight:800;color:var(--muted);font-size:13px;">جارٍ التحميل...</div>
</div>

<div id="navbar" class="hidden" style="position:sticky;top:0;background:var(--bg);z-index:100;border-bottom:2.5px solid var(--line);">
  <div style="max-width:1000px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;padding:10px 14px;gap:10px;">
    <div style="display:flex;align-items:center;gap:8px;cursor:pointer;" onclick="go('discover')">
      <div style="width:34px;height:34px;background:var(--brand);border:2.5px solid var(--line);border-radius:10px;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:900;">V</div>
      <div style="font-weight:900;font-size:18px;" class="md-show">VentureHub</div>
    </div>
    <div style="display:flex;align-items:center;gap:10px;">
      <div style="cursor:pointer;" onclick="go('diagnostics')" title="تشخيص المشاكل"><i class="fa-solid fa-stethoscope" style="font-size:17px;color:var(--muted);"></i></div>
      <div style="position:relative;cursor:pointer;" onclick="go('notifications')">
        <i class="fa-solid fa-bell" style="font-size:20px;"></i>
        <span id="notifDot" class="hidden" style="position:absolute;top:-3px;left:-3px;width:9px;height:9px;background:var(--danger);border-radius:50%;border:1.5px solid #fff;"></span>
      </div>
      <img id="navAvatar" class="avatar" style="width:34px;height:34px;cursor:pointer;" onclick="go('profile',{uid:currentUser?.uid})">
    </div>
  </div>
  <div class="scrollx md-show" style="max-width:1000px;margin:0 auto;padding:0 14px 10px;display:flex;gap:8px;">
    <div class="tab-btn" data-nav="discover" onclick="go('discover')">🧭 اكتشف</div>
    <div class="tab-btn" data-nav="startups" onclick="go('startups')">🚀 المشاريع</div>
    <div class="tab-btn" data-nav="messages" onclick="go('messages')" style="position:relative;">💬 رسائلي<span id="navMsgDot" class="hidden" style="position:absolute;top:2px;left:2px;width:8px;height:8px;background:var(--danger);border-radius:50%;border:1.5px solid var(--bg);"></span></div>
    <div class="tab-btn" data-nav="profile" onclick="go('profile',{uid:currentUser?.uid})">👤 حسابي</div>
  </div>
</div>

<div id="app" style="max-width:1000px;margin:0 auto;padding:14px 14px 90px;"></div>

<div class="bottom-nav md-hide hidden" id="bottomNav">
  <div class="bn-item" data-nav="discover" onclick="go('discover')"><i class="fa-solid fa-compass"></i>اكتشف</div>
  <div class="bn-item" data-nav="startups" onclick="go('startups')"><i class="fa-solid fa-rocket"></i>المشاريع</div>
  <div class="bn-item" data-nav="messages" onclick="go('messages')" style="position:relative;"><i class="fa-solid fa-message"></i>رسائلي<span id="navMsgDotMobile" class="hidden" style="position:absolute;top:2px;left:22px;width:8px;height:8px;background:var(--danger);border-radius:50%;"></span></div>
  <div class="bn-item" data-nav="notifications" onclick="go('notifications')"><i class="fa-solid fa-bell"></i>إشعارات</div>
  <div class="bn-item" data-nav="profile" onclick="go('profile',{uid:currentUser?.uid})"><i class="fa-solid fa-user"></i>حسابي</div>
</div>

<div id="modalRoot"></div>
<div class="toast-wrap" id="toastWrap"></div>

<script>
/* ============================================================
   VentureHub MVP — نسخة مبسّطة ومركّزة على الأساس:
   بروفايل → اكتشاف أشخاص → نشر فكرة/مشروع → طلب انضمام لفريق → رسائل مباشرة.
   Schema:
   users/{uid} { name, email, role, bio, skills[], interests[], location, availability, avatarSeed, createdAt }
   startups/{id} { founderId, title, tagline, description, stage, neededSkills[], createdAt, status }
   joinRequests/{startupId}/{uid} { uid, message, status, createdAt }
   notifications/{uid}/{id} { type, text, fromId, relatedId, read, createdAt }
   conversations/{id} { members{uid:true}, lastMessage, updatedAt, lastSenderId }
   messages/{convId}/{id} { senderId, text, createdAt }
   userConversations/{uid}/{convId} true
   directConvLookup/{key} convId
   ============================================================ */

/* ============ FIREBASE ============ */
const firebaseConfig = {
  apiKey: "AIzaSyAAM11KB7jbdZC0EiPyOgIawxzGZITgMA8",
  authDomain: "flash-feedback-9c529.firebaseapp.com",
  databaseURL: "https://flash-feedback-9c529-default-rtdb.europe-west1.firebasedatabase.app",
  projectId: "flash-feedback-9c529",
  storageBucket: "flash-feedback-9c529.firebasestorage.app",
  messagingSenderId: "1026286586523",
  appId: "1:1026286586523:web:b76e33473c260fc4d7143e"
};
firebase.initializeApp(firebaseConfig);
const auth = firebase.auth();
const db = firebase.database();

const ROLE_LABELS = {founder:'مؤسس',talent:'موهبة',mentor:'مرشد'};
const ROLE_ICONS = {founder:'🚀',talent:'💡',mentor:'🧠'};
const STAGE_LABELS = {idea:'فكرة',mvp:'نموذج أولي',growth:'نمو'};
const SKILL_SUGGESTIONS = ['برمجة Frontend','برمجة Backend','تصميم UI/UX','تسويق رقمي','مبيعات','إدارة منتج','تمويل واستثمار','محتوى وكتابة','ذكاء اصطناعي','تحليل بيانات','فيديو ومونتاج','قانون وعقود'];

let currentUser=null, myProfile=null, route={name:'landing',params:{}};
let allUsersCache={};
let convBadgeUnsub=null, notifUnsub=null, activeMsgUnsub=null, msgListUnsub=null;

/* ============ HELPERS ============ */
function esc(s){return String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
function uid(){return db.ref().push().key;}
function avatarUrl(u){return (u&&u.avatar)||'https://api.dicebear.com/7.x/initials/svg?seed='+encodeURIComponent((u&&u.name)||'U')+'&backgroundColor=6c4dfb&textColor=ffffff';}
function toast(msg,type){
  const wrap=document.getElementById('toastWrap');
  const el=document.createElement('div');
  el.className='toast'+(type?(' '+type):'');
  el.textContent=msg;
  wrap.appendChild(el);
  setTimeout(()=>el.remove(),3200);
}
function timeAgo(ts){
  if(!ts)return'';
  const s=Math.floor((Date.now()-ts)/1000);
  if(s<60)return'الآن';
  if(s<3600)return Math.floor(s/60)+' د';
  if(s<86400)return Math.floor(s/3600)+' س';
  if(s<604800)return Math.floor(s/86400)+' يوم';
  return new Date(ts).toLocaleDateString('ar-EG');
}
function openModal(html){
  document.getElementById('modalRoot').innerHTML=`<div class="modal-backdrop" onclick="if(event.target===this)closeModal()">
    <div class="modal-box">
      <div class="modal-close"><span onclick="closeModal()">✕</span></div>
      <div style="padding:6px 20px 24px;">${html}</div>
    </div>
  </div>`;
  document.addEventListener('keydown',escCloseModal);
}
function escCloseModal(e){if(e.key==='Escape')closeModal();}
function closeModal(){document.getElementById('modalRoot').innerHTML='';document.removeEventListener('keydown',escCloseModal);}
function requireAuth(){if(!currentUser){go('auth');toast('سجّل دخولك أولًا');return false;}return true;}
async function fetchUserCached(uid){
  if(!uid)return{};
  if(allUsersCache[uid])return allUsersCache[uid];
  try{
    const snap=await db.ref('users/'+uid).get();
    const val=snap.val()||{};
    allUsersCache[uid]=val;
    return val;
  }catch(e){console.error('fetchUserCached failed',uid,e);return{};}
}
function stopRealtimeListeners(){
  if(notifUnsub){try{notifUnsub();}catch(e){} notifUnsub=null;}
  if(convBadgeUnsub){try{convBadgeUnsub();}catch(e){} convBadgeUnsub=null;}
  if(activeMsgUnsub){try{activeMsgUnsub();}catch(e){} activeMsgUnsub=null;}
  if(msgListUnsub){try{msgListUnsub();}catch(e){} msgListUnsub=null;}
}

/* ============ ROUTER ============ */
function go(name,params={}){
  route={name,params};
  render();
  document.querySelectorAll('[data-nav]').forEach(el=>el.classList.toggle('active',el.dataset.nav===name));
  window.scrollTo(0,0);
}
function render(){
  const app=document.getElementById('app');
  const r={
    landing:renderLanding, auth:renderAuth, onboarding:renderOnboarding,
    discover:renderDiscover, profile:renderProfile,
    startups:renderStartups, startupDetail:renderStartupDetail,
    messages:renderMessages, notifications:renderNotifications,
    diagnostics:renderDiagnostics
  };
  app.innerHTML='';
  try{(r[route.name]||renderLanding)(app);}
  catch(e){console.error('render failed for route',route.name,e);app.innerHTML='<div class="card" style="padding:24px;text-align:center;color:var(--danger);">حصل خطأ في عرض الصفحة. افتح 🩺 تشخيص المشاكل.</div>';}
}

/* ============ AUTH ============ */
auth.onAuthStateChanged(async(user)=>{
  currentUser=user;
  stopRealtimeListeners();
  document.getElementById('loaderPage').classList.add('hidden');
  if(user){
    let snap;
    try{snap=await db.ref('users/'+user.uid).get();}
    catch(e){
      console.error(e);
      document.getElementById('app').innerHTML='<div class="card" style="margin:30px auto;max-width:640px;padding:24px;text-align:center;color:var(--danger);"><b>تعذر الاتصال بقاعدة البيانات</b><div style="margin-top:8px;color:var(--muted);font-size:13px;">تأكد أن Realtime Database Rules منشورة صح.</div><button class="btn" style="margin-top:14px;" onclick="location.reload()">إعادة المحاولة</button></div>';
      return;
    }
    if(snap.exists()){
      myProfile=snap.val();
      document.getElementById('navbar').classList.remove('hidden');
      document.getElementById('bottomNav').classList.remove('hidden');
      document.getElementById('navAvatar').src=avatarUrl(myProfile);
      allUsersCache[user.uid]=myProfile;
      listenNotifications();
      listenConvBadge();
      go('discover');
    }else{
      go('onboarding');
    }
  }else{
    myProfile=null;
    document.getElementById('navbar').classList.add('hidden');
    document.getElementById('bottomNav').classList.add('hidden');
    go('landing');
  }
});
function doRegister(email,pass){return auth.createUserWithEmailAndPassword(email,pass);}
function doLogin(email,pass){return auth.signInWithEmailAndPassword(email,pass);}
function doLogout(){stopRealtimeListeners();auth.signOut();go('landing');}
function resetPassword(){
  const email=(document.getElementById('afEmail')?.value||'').trim();
  if(!email){toast('اكتب بريدك الإلكتروني في الخانة فوق الأول','error');return;}
  auth.sendPasswordResetEmail(email).then(()=>toast('تم إرسال رابط إعادة تعيين كلمة المرور لبريدك','success')).catch(()=>toast('تعذر إرسال الرابط، تأكد من صحة البريد','error'));
}

/* ============ LANDING ============ */
function renderLanding(app){
  app.innerHTML=`
  <div style="padding:30px 0 10px;text-align:center;">
    <div style="display:inline-flex;align-items:center;gap:10px;margin-bottom:18px;">
      <div style="width:44px;height:44px;background:var(--brand);border:2.5px solid var(--line);border-radius:12px;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:900;font-size:20px;">V</div>
      <div style="font-weight:900;font-size:22px;">VentureHub</div>
    </div>
    <h1 style="font-size:32px;font-weight:900;line-height:1.4;margin:0 0 12px;">لاقي اللي شبهك.<br>ابنوا فكرة مع بعض.<br><span style="color:var(--brand);">وحوّلوها منتج.</span></h1>
    <p style="color:var(--muted);font-size:16px;max-width:460px;margin:0 auto 22px;">منصة عربية تجمع المؤسسين والمواهب والمرشدين عشان يلاقوا بعض ويبنوا فرق حقيقية.</p>
    <div style="display:flex;gap:10px;justify-content:center;flex-wrap:wrap;">
      <button class="btn btn-brand" style="font-size:16px;padding:12px 26px;" onclick="go('auth',{mode:'register'})">ابدأ مجانًا</button>
      <button class="btn" style="font-size:16px;padding:12px 26px;" onclick="go('auth',{mode:'login'})">تسجيل الدخول</button>
    </div>
  </div>
  <div class="core-grid" style="margin-top:30px;">
    <div class="card" style="padding:18px;text-align:center;"><div style="font-size:30px;">🧭</div><b>اكتشف</b><div style="color:var(--muted);font-size:13px;margin-top:4px;">لاقي مؤسسين ومواهب بمهارات تكمّل مشروعك</div></div>
    <div class="card" style="padding:18px;text-align:center;"><div style="font-size:30px;">🚀</div><b>انشر فكرتك</b><div style="color:var(--muted);font-size:13px;margin-top:4px;">اعرض مشروعك واستقبل طلبات انضمام</div></div>
    <div class="card" style="padding:18px;text-align:center;"><div style="font-size:30px;">💬</div><b>تواصل مباشرة</b><div style="color:var(--muted);font-size:13px;margin-top:4px;">رسائل مباشرة سريعة وبسيطة</div></div>
  </div>`;
}

/* ============ AUTH SCREEN ============ */
function renderAuth(app){
  const mode=route.params.mode||'login';
  app.innerHTML=`
  <div class="card" style="max-width:440px;margin:20px auto;padding:26px;">
    <div style="text-align:center;margin-bottom:18px;">
      <div style="width:44px;height:44px;background:var(--brand);border:2.5px solid var(--line);border-radius:12px;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:900;font-size:20px;margin:0 auto 10px;">V</div>
      <h2 style="font-weight:900;margin:0;">${mode==='register'?'إنشاء حساب':'تسجيل الدخول'}</h2>
    </div>
    ${mode==='register'?'<input id="afName" class="input" placeholder="اسمك بالكامل" style="margin-bottom:10px;">':''}
    <input id="afEmail" class="input" placeholder="البريد الإلكتروني" style="margin-bottom:10px;" type="email">
    <input id="afPass" class="input" placeholder="كلمة المرور" style="margin-bottom:14px;" type="password">
    <button class="btn btn-brand" style="width:100%;" id="authSubmitBtn" onclick="submitAuth('${mode}')">${mode==='register'?'إنشاء الحساب':'دخول'}</button>
    ${mode==='login'?'<div style="text-align:center;margin-top:10px;"><span style="font-size:13px;color:var(--brand);cursor:pointer;" onclick="resetPassword()">نسيت كلمة المرور؟</span></div>':''}
    <div style="text-align:center;margin-top:16px;font-size:14px;">
      ${mode==='register'?'عندك حساب بالفعل؟ <b style="color:var(--brand);cursor:pointer;" onclick="go(\'auth\',{mode:\'login\'})">سجّل دخولك</b>':'مستخدم جديد؟ <b style="color:var(--brand);cursor:pointer;" onclick="go(\'auth\',{mode:\'register\'})">أنشئ حساب</b>'}
    </div>
  </div>`;
}
async function submitAuth(mode){
  const email=document.getElementById('afEmail').value.trim();
  const pass=document.getElementById('afPass').value;
  const name=mode==='register'?document.getElementById('afName').value.trim():'';
  if(!email||!pass){toast('اكتب البريد وكلمة المرور','error');return;}
  if(mode==='register'&&!name){toast('اكتب اسمك','error');return;}
  const btn=document.getElementById('authSubmitBtn');btn.disabled=true;btn.textContent='جارٍ...';
  try{
    if(mode==='register'){
      const cred=await doRegister(email,pass);
      await db.ref('users/'+cred.user.uid).set({uid:cred.user.uid,name,email,role:'',bio:'',location:'',skills:[],interests:[],availability:'available',createdAt:Date.now()});
    }else{
      await doLogin(email,pass);
    }
  }catch(e){
