function openNotifTarget(id,type,relatedId,fromId){
  if(type==='message'){go('messages');return;}
  if((type==='join_request'||type==='join_accepted'||type==='join_rejected')&&relatedId){go('startupDetail',{id:relatedId});return;}
  if(fromId)go('profile',{uid:fromId});
}

/* ============ صفحة تشخيص المشاكل ============ */
function diagRow(label,status,detail){
