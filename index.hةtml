}
async function closeStartup(id){
  try{
    const snap=await db.ref('startups/'+id+'/status').get();
    const newStatus=snap.val()==='closed'?'open':'closed';
    await db.ref('startups/'+id+'/status').set(newStatus);
    startupsAllCache=null;
    toast(newStatus==='closed'?'تم إغلاق المشروع':'تم إعادة فتح المشروع','success');
    go('startupDetail',{id});
  }catch(e){console.error(e);toast('تعذر التنفيذ','error');}
}
function openJoinRequest(startupId){
  if(!requireAuth())return;
  openModal(`<h3 style="font-weight:900;margin-bottom:14px;">اطلب الانضمام</h3>
    <label style="font-weight:800;font-size:13px;">ليه انت مناسب للفريق ده؟</label>
    <textarea id="jrMsg" class="input" rows="4" style="margin:8px 0 16px;" placeholder="اكتب رسالة قصيرة للمؤسس..."></textarea>
    <button class="btn btn-brand" style="width:100%;" id="jrSubmitBtn" onclick="submitJoinRequest('${startupId}')">إرسال الطلب</button>`);
