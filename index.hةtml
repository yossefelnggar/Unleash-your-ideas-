  if(!targetUid||targetUid===currentUser?.uid)return;
  db.ref('notifications/'+targetUid+'/'+uid()).set({type,text,fromId:currentUser.uid,relatedId:relatedId||'',read:false,createdAt:Date.now()}).catch(e=>console.warn('notify failed',e));
}
function listenNotifications(){
  if(notifUnsub){try{notifUnsub();}catch(e){} notifUnsub=null;}
