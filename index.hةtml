  }catch(e){console.error(e);toast('تعذر إرسال الطلب، ممكن يكون عندك طلب مُرسَل بالفعل','error');btn.disabled=false;btn.textContent='إرسال الطلب';}
}
async function loadJoinRequests(startupId){
  const el=document.getElementById('joinRequestsList');
  if(!el)return;
  try{
    const snap=await db.ref('joinRequests/'+startupId).get();
    const arr=[];snap.forEach(c=>arr.push({...c.val()}));
    arr.sort((a,b)=>(b.createdAt||0)-(a.createdAt||0));
    if(!arr.length){el.innerHTML='<div class="card" style="padding:20px;text-align:center;color:var(--muted);">لسه مفيش طلبات انضمام</div>';return;}
    await Promise.all(arr.map(r=>fetchUserCached(r.uid).catch(()=>{})));
    el.innerHTML=arr.map(r=>{
      try{
        const u=allUsersCache[r.uid]||{};
        const statusLabel={pending:'معلّق',accepted:'مقبول',rejected:'مرفوض'}[r.status]||'معلّق';
        const statusColor={pending:'var(--warn)',accepted:'var(--accent)',rejected:'var(--danger)'}[r.status]||'var(--warn)';
        return `<div class="card" style="padding:14px;margin-bottom:10px;">
          <div style="display:flex;gap:10px;align-items:center;">
            <img class="avatar" style="width:40px;height:40px;cursor:pointer;" src="${avatarUrl(u)}" onclick="go('profile',{uid:'${r.uid}'})">
            <div style="flex:1;"><b style="cursor:pointer;" onclick="go('profile',{uid:'${r.uid}'})">${esc(u.name||'مستخدم')}</b><div style="font-size:11px;color:${statusColor};font-weight:800;">${statusLabel}</div></div>
          </div>
          ${r.message?`<div style="margin-top:8px;font-size:13px;color:var(--muted);">${esc(r.message)}</div>`:''}
          ${r.status==='pending'?`<div style="display:flex;gap:8px;margin-top:10px;"><button class="btn btn-brand" style="flex:1;font-size:12px;padding:8px;" onclick="respondJoinRequest('${startupId}','${r.uid}','accepted')">قبول</button><button class="btn" style="flex:1;font-size:12px;padding:8px;" onclick="respondJoinRequest('${startupId}','${r.uid}','rejected')">رفض</button></div>`:''}
        </div>`;
      }catch(err){console.error('تعذر عرض طلب انضمام',err);return'';}
    }).join('');
  }catch(e){console.error(e);el.innerHTML='<div class="card" style="padding:20px;text-align:center;color:var(--danger);">تعذر تحميل الطلبات</div>';}
}
async function respondJoinRequest(startupId,requesterUid,status){
  try{
    await db.ref('joinRequests/'+startupId+'/'+requesterUid+'/status').set(status);
    const sSnap=await db.ref('startups/'+startupId).get();
    const s=sSnap.val();
    notify(requesterUid,status==='accepted'?'join_accepted':'join_rejected',status==='accepted'?('تم قبول طلب انضمامك لمشروع "'+(s?.title||'')+'"'):('تم رفض طلب انضمامك لمشروع "'+(s?.title||'')+'"'),startupId);
    toast(status==='accepted'?'تم القبول':'تم الرفض','success');
    loadJoinRequests(startupId);
  }catch(e){console.error(e);toast('تعذر التنفيذ','error');}
}

/* ============ الرسائل المباشرة (بسيطة وموثوقة) ============ */
function directKey(a,b){return [a,b].sort().join('_');}
async function startConversation(otherUid){
  if(!requireAuth()||!otherUid||otherUid===currentUser.uid)return;
  try{
    const key=directKey(currentUser.uid,otherUid);
    const lookupSnap=await db.ref('directConvLookup/'+key).get();
    if(lookupSnap.exists()){go('messages',{convId:lookupSnap.val()});return;}
    const convId=uid();
    const updates={};
    updates['conversations/'+convId]={members:{[currentUser.uid]:true,[otherUid]:true},lastMessage:'',updatedAt:Date.now(),lastSenderId:''};
    updates['userConversations/'+currentUser.uid+'/'+convId]=true;
    updates['userConversations/'+otherUid+'/'+convId]=true;
    updates['directConvLookup/'+key]=convId;
    await db.ref().update(updates);
    go('messages',{convId});
  }catch(e){console.error(e);toast('تعذر بدء المحادثة','error');}
}
function listenConvBadge(){
  if(convBadgeUnsub){try{convBadgeUnsub();}catch(e){} convBadgeUnsub=null;}
  const ucRef=db.ref('userConversations/'+currentUser.uid);
  const cb=ucRef.on('value',async snap=>{
    try{
      const ids=snap.exists()?Object.keys(snap.val()):[];
      let unread=false;
      for(const id of ids){
        try{
          const cSnap=await db.ref('conversations/'+id).get();
          const c=cSnap.val();
          if(c&&c.lastSenderId&&c.lastSenderId!==currentUser.uid){
            const readSnap=await db.ref('conversations/'+id+'/readBy/'+currentUser.uid).get();
            if(!readSnap.exists()||readSnap.val()<(c.updatedAt||0)){unread=true;break;}
          }
        }catch(e){/* تجاهل خطأ محادثة واحدة عشان الباقي يشتغل */}
      }
      document.getElementById('navMsgDot')?.classList.toggle('hidden',!unread);
      document.getElementById('navMsgDotMobile')?.classList.toggle('hidden',!unread);
    }catch(e){console.error('convBadge failed',e);}
  },err=>console.warn('convBadge error',err));
  convBadgeUnsub=()=>ucRef.off('value',cb);
}
function markConvRead(convId,ts){
  db.ref('conversations/'+convId+'/readBy/'+currentUser.uid).set(ts).catch(()=>{});
}
async function renderMessages(app){
  if(!requireAuth())return;
  app.innerHTML=`
  <div class="msg-layout" style="display:grid;grid-template-columns:${route.params.convId?'1fr 2fr':'1fr'};gap:14px;" id="msgLayout">
    <div class="card ${route.params.convId?'msg-list-mobile-hide':''}" style="padding:10px;height:calc(100vh - 180px);overflow-y:auto;" id="convList">
      <div style="padding:6px 4px 12px;"><b>الرسائل</b></div>
      <div id="convItems"><div style="text-align:center;padding:20px;color:var(--muted);"><i class="fa-solid fa-spinner spin"></i></div></div>
    </div>
    <div id="convWindow" class="${route.params.convId?'':'hidden'}"></div>
  </div>`;
  loadConvList();
  if(route.params.convId)openConversation(route.params.convId);
}
async function loadConvList(){
  const el=document.getElementById('convItems');
  if(!el)return;
  if(msgListUnsub){try{msgListUnsub();}catch(e){} msgListUnsub=null;}
  const ucRef=db.ref('userConversations/'+currentUser.uid);
  let convListToken=0;
  const cb=ucRef.on('value',async snap=>{
    const myToken=++convListToken;
    try{
      const ids=snap.exists()?Object.keys(snap.val()):[];
      if(!ids.length){if(myToken===convListToken)el.innerHTML='<div style="text-align:center;padding:20px;color:var(--muted);font-size:13px;">لسه مفيش محادثات.<br>ابدأ من صفحة "اكتشف" أو من أي مشروع.</div>';return;}
      const convs=[];
      for(const id of ids){
        try{const cSnap=await db.ref('conversations/'+id).get();if(cSnap.exists())convs.push({id,...cSnap.val()});}catch(e){/* تجاهل واحدة عشان الباقي يظهر */}
      }
      if(myToken!==convListToken)return;
      convs.sort((a,b)=>(b.updatedAt||0)-(a.updatedAt||0));
      await Promise.all(convs.map(c=>{const otherId=Object.keys(c.members||{}).find(m=>m!==currentUser.uid);return otherId?fetchUserCached(otherId).catch(()=>{}):Promise.resolve();}));
      if(myToken!==convListToken)return;
      el.innerHTML=convs.map(c=>{
        try{
          const otherId=Object.keys(c.members||{}).find(m=>m!==currentUser.uid);
          const other=allUsersCache[otherId]||{};
          const active=route.params.convId===c.id;
          return `<div onclick="go('messages',{convId:'${c.id}'})" style="display:flex;gap:10px;align-items:center;padding:10px 8px;border-radius:12px;cursor:pointer;background:${active?'var(--soft)':'transparent'};">
            <img class="avatar" style="width:42px;height:42px;" src="${avatarUrl(other)}">
            <div style="flex:1;min-width:0;">
              <div style="font-weight:800;font-size:14px;">${esc(other.name||'مستخدم')}</div>
              <div style="font-size:12px;color:var(--muted);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${esc(c.lastMessage||'ابدأ المحادثة')}</div>
            </div>
          </div>`;
        }catch(err){console.error('تعذر عرض محادثة',c.id,err);return'';}
      }).join('');
    }catch(e){console.error('فشل تحميل قائمة المحادثات',e);if(myToken===convListToken)el.innerHTML='<div style="text-align:center;padding:20px;color:var(--danger);font-size:13px;">تعذر تحميل المحادثات</div>';}
  },err=>{console.error(err);el.innerHTML='<div style="text-align:center;padding:20px;color:var(--danger);font-size:13px;">تعذر تحميل المحادثات</div>';});
  msgListUnsub=()=>ucRef.off('value',cb);
}
function renderMessageBubble(m,convId){
  const mine=m.senderId===currentUser.uid;
  const sender=allUsersCache[m.senderId]||{};
  return `<div class="msg-row ${mine?'mine':'theirs'}">
    ${!mine?`<img class="avatar msg-avatar" src="${avatarUrl(sender)}">`:''}
    <div style="max-width:min(78%,520px);">
      <div class="msg-bubble">${esc(m.text||'')}</div>
      <div class="msg-meta" style="text-align:${mine?'left':'right'};">${mine?'أنت':esc(sender.name||'')} · ${timeAgo(m.createdAt)}</div>
    </div>
    ${mine?`<img class="avatar msg-avatar" src="${avatarUrl(myProfile)}">`:''}
  </div>`;
}
function openConversation(convId){
  if(!requireAuth()||!convId)return;
  markConvRead(convId,Date.now());
  const layout=document.getElementById('msgLayout');
  if(layout)layout.style.gridTemplateColumns='1fr 2fr';
  document.getElementById('convList')?.classList.add('msg-list-mobile-hide');
  document.getElementById('convWindow')?.classList.remove('hidden');
  const win=document.getElementById('convWindow');
  if(!win)return;
  win.innerHTML='<div class="card" style="display:flex;align-items:center;justify-content:center;height:calc(100vh - 180px);"><i class="fa-solid fa-spinner spin"></i></div>';
  db.ref('conversations/'+convId).once('value').then(async cs=>{
    const c=cs.val();
    if(!c||!c.members||!c.members[currentUser.uid]){win.innerHTML='<div class="card" style="padding:30px;text-align:center;color:var(--muted);">لا يمكنك فتح هذه المحادثة</div>';return;}
    const otherId=Object.keys(c.members).find(m=>m!==currentUser.uid);
    const other=otherId?await fetchUserCached(otherId):{};
    win.innerHTML=`<div class="card" style="display:flex;flex-direction:column;height:calc(100vh - 180px);">
      <div style="padding:12px 14px;border-bottom:2.5px solid var(--line);display:flex;align-items:center;gap:10px;">
        <div class="md-hide" style="cursor:pointer;padding:4px;" onclick="go('messages')" title="رجوع"><i class="fa-solid fa-arrow-right"></i></div>
        <img class="avatar" style="width:42px;height:42px;cursor:pointer;" src="${avatarUrl(other)}" onclick="go('profile',{uid:'${otherId}'})">
        <div style="cursor:pointer;" onclick="go('profile',{uid:'${otherId}'})"><div style="font-weight:900;">${esc(other.name||'مستخدم')}</div><div style="font-size:11px;color:var(--muted);">${ROLE_LABELS[other.role]||''}</div></div>
      </div>
      <div id="msgBody" style="flex:1;overflow-y:auto;padding:14px;display:flex;flex-direction:column;gap:6px;"></div>
      <div style="display:flex;gap:8px;padding:10px;border-top:2.5px solid var(--line);">
        <input id="msgInput" class="input" placeholder="اكتب رسالة..." onkeydown="if(event.key==='Enter')sendMessage('${convId}')">
        <button class="btn btn-brand" onclick="sendMessage('${convId}')"><i class="fa-solid fa-paper-plane"></i></button>
      </div>
    </div>`;
    if(activeMsgUnsub){try{activeMsgUnsub();}catch(e){} activeMsgUnsub=null;}
    const msgRef=db.ref('messages/'+convId).orderByChild('createdAt');
    let msgRenderToken=0;
    const msgCb=msgRef.on('value',async snap=>{
      const myToken=++msgRenderToken;
      try{
        const arr=[];snap.forEach(c2=>arr.push({id:c2.key,...c2.val()}));
        await Promise.all(arr.map(m=>fetchUserCached(m.senderId).catch(()=>{})));
        if(myToken!==msgRenderToken)return;
        const body=document.getElementById('msgBody');
        if(!body)return;
        body.innerHTML=arr.map(m=>{
          try{return renderMessageBubble(m,convId);}
          catch(errRow){console.error('تعذر عرض رسالة',m&&m.id,errRow);return `<div style="text-align:center;color:var(--danger);font-size:11px;padding:4px;">⚠️ تعذر عرض رسالة</div>`;}
        }).join('')||'<div style="text-align:center;color:var(--muted);padding:30px;">ابدأ أول رسالة.</div>';
        body.scrollTop=body.scrollHeight;
        markConvRead(convId,Date.now());
      }catch(errAll){
        console.error('فشل تحديث شاشة الرسائل بالكامل',errAll);
        const body=document.getElementById('msgBody');
        if(body)body.innerHTML='<div style="text-align:center;color:var(--danger);padding:30px;">حصل خطأ غير متوقع. افتح 🩺 تشخيص المشاكل.</div>';
      }
    },err=>{console.error(err);const body=win.querySelector('#msgBody');if(body)body.innerHTML='<div style="text-align:center;color:var(--danger);padding:30px;">تعذر تحميل الرسائل</div>';});
    activeMsgUnsub=()=>msgRef.off('value',msgCb);
  }).catch(e=>{console.error(e);win.innerHTML='<div class="card" style="padding:30px;text-align:center;color:var(--danger);">تعذر فتح المحادثة</div>';});
}
async function sendMessage(convId){
  if(!requireAuth()||!convId)return;
  const input=document.getElementById('msgInput');
  if(!input)return;
  const text=input.value.trim();
  if(!text)return;
  const btn=input.nextElementSibling;
  if(btn)btn.disabled=true;
  try{
    const convSnap=await db.ref('conversations/'+convId).get();
    const conv=convSnap.val();
    if(!conv||!conv.members||!conv.members[currentUser.uid]){toast('لا يمكنك إرسال رسالة هنا','error');return;}
    const now=Date.now();
    const mid=uid();
    await db.ref('messages/'+convId+'/'+mid).set({senderId:currentUser.uid,text,createdAt:now});
    await db.ref('conversations/'+convId).update({lastMessage:text,updatedAt:now,lastSenderId:currentUser.uid});
    markConvRead(convId,now);
    input.value='';
    Object.keys(conv.members||{}).filter(id=>id!==currentUser.uid).forEach(id=>notify(id,'message','أرسل لك '+(myProfile?.name||'شخص')+' رسالة جديدة',convId));
  }catch(e){console.error(e);toast('تعذر إرسال الرسالة، تأكد من اتصالك بالإنترنت','error');}
  finally{if(btn)btn.disabled=false;}
}

/* ============ الإشعارات ============ */
