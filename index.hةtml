        :`<button class="btn btn-brand" onclick="openJoinRequest('${s.id}')"><i class="fa-solid fa-handshake"></i> اطلب الانضمام للفريق</button><button class="btn" onclick="startConversation('${s.founderId}')"><i class="fa-solid fa-message"></i> راسل المؤسس</button>`}
